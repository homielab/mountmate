"Right-click a volume and choose “Custom Mount Point…” to mount it in a folder of your choice. Removing an entry also removes its system mount rule (/etc/fstab) and may ask for your admin password." = "Nhấp chuột phải vào một phân vùng và chọn “Điểm gắn tùy chỉnh…” để gắn nó vào thư mục bạn chọn. Xóa một mục cũng xóa quy tắc gắn hệ thống của mục đó (/etc/fstab) và có thể yêu cầu mật khẩu quản trị viên.";
"Right-click a volume and choose “Keep Mounted (Auto-Reconnect)” to remount it automatically when it drops." = "Nhấp chuột phải vào một phân vùng và chọn “Giữ gắn kết (tự động)” để tự động gắn lại khi nó bị ngắt.";
"Right-click a volume and choose “Pin to Top” to list it first." = "Nhấp chuột phải vào một phân vùng và chọn “Ghim lên đầu” để hiển thị nó đầu tiên.";
"Saving…" = "Đang lưu…";
"System Default" = "Mặc định hệ thống";
"System Mount Rule Changed During Update" = "/etc/fstab đã bị một tiến trình khác thay đổi trong lúc cập nhật. Vui lòng thử lại.";
"This shortcut is used by another app. Choose a different one." = "Phím tắt này đang được ứng dụng khác sử dụng. Hãy chọn phím tắt khác.";
"Unmount “%@”" = "Tháo “%@”";
"Version %@ (%@)" = "Phiên bản %@ (%@)";
"Vol: %@" = "Phân vùng: %@";
"Volume Not Connected" = "Phân vùng chưa kết nối";
"Import Mounted" = "Nhập ổ đang gắn";
"Import SMB shares that are currently mounted in Finder" = "Nhập các thư mục chia sẻ SMB đang được gắn trong Finder";
"Imported %d mounted share(s). Add credentials by editing each share." = "Đã nhập %d thư mục chia sẻ đang gắn. Hãy thêm thông tin đăng nhập bằng cách sửa từng thư mục chia sẻ.";
"No mounted SMB shares were found." = "Không tìm thấy thư mục chia sẻ SMB nào đang được gắn.";
"Those mounted shares are already in MountMate." = "Các thư mục chia sẻ đang gắn này đã có trong MountMate.";
