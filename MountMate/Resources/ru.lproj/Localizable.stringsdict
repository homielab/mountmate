	<key>shares.imported</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Импортирован %d подключённый ресурс. Добавьте учётные данные, отредактировав его.</string>
			<key>few</key>
			<string>Импортировано %d подключённых ресурса. Добавьте учётные данные, отредактировав каждый ресурс.</string>
			<key>many</key>
			<string>Импортировано %d подключённых ресурсов. Добавьте учётные данные, отредактировав каждый ресурс.</string>
			<key>other</key>
			<string>Импортировано %d подключённых ресурсов. Добавьте учётные данные, отредактировав каждый ресурс.</string>
		</dict>
	</dict>
