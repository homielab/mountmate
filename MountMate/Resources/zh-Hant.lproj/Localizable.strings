"Failed to rename “%@” because it is currently in use by another application." = "無法重新命名「%@」，因為它正被其他應用程式使用。";
"“%@” could not be renamed. Its file system may not support renaming from macOS (for example NTFS), or the disk may be read-only." = "無法重新命名「%@」。其檔案系統可能不支援在 macOS 中重新命名（例如 NTFS），或磁碟可能是唯讀的。";
"“%@” is busy: a file on it is still in use." = "「%@」正忙：其中的檔案仍在使用。";
"“%@” is no longer mounted." = "「%@」已不再掛載。";
"Could not unmount “%@” (code %d)." = "無法卸載「%@」（代碼 %d）。";

// MARK: - Mount / Unmount All Saved Shares
"Mount All Saved Shares" = "掛載所有已儲存的共享";
"Unmount All Saved Shares" = "卸載所有已儲存的共享";
"Mount All Network Shares" = "掛載所有網路共享";
"Unmount All Network Shares" = "卸載所有網路共享";
"Mounts every network share saved in MountMate that is not mounted yet." = "掛載 MountMate 中儲存且尚未掛載的所有網路共享。";
"Unmounts every mounted network share saved in MountMate." = "卸載 MountMate 中儲存且已掛載的所有網路共享。";
"Network shares mounted." = "網路共享已掛載。";
"Network shares unmounted." = "網路共享已卸載。";

/* Mount and eject errors */
"Another operation on this volume is running." = "此卷宗上的另一項操作正在進行。";
"Timed out waiting for the mount to finish." = "等待掛載完成逾時。";
"This disk is already being ejected." = "此磁碟正在推出。";

/* Feedback after a global keyboard shortcut */
"Nothing to unmount" = "沒有可卸載的卷宗";
"Nothing to mount" = "沒有可掛載的卷宗";
"Nothing to eject" = "沒有可推出的磁碟";
"No network shares to mount" = "沒有可掛載的網路共享";
"No network shares to unmount" = "沒有可卸載的網路共享";
"hotkey.feedback.mixed" = "%1$@，%2$@";

// MARK: - Shortcuts: eject volume
"Eject Volume" = "推出磁碟卷";
"Ejects the external disk that holds one volume, chosen by its name. A disk with a protected volume is refused." = "依名稱選擇一個磁碟卷，推出包含它的外接磁碟。含有受保護磁碟卷的磁碟會被拒絕。";
"“%@” ejected." = "已推出「%@」。";
"Could not eject “%@”." = "無法推出「%@」。";
"Could not eject “%@”: %@" = "無法推出「%@」：%@";
"The disk holding “%@” has a protected volume, so it was not ejected." = "包含「%@」的磁碟有受保護的磁碟卷，因此未推出。";
"“%1$@” was not mounted at “%2$@” because that folder is not empty: mounting there would hide its files until the share is unmounted. Choose an empty folder as the mount point." = "未將「%1$@」掛載到「%2$@」，因為該檔案夾不是空的：掛載後其中的檔案會被隱藏，直到卸載該共享。請選擇一個空的檔案夾作為掛載點。";

/* Network share export and import */
"Export Shares…" = "匯出共享…";
"Import Shares from File…" = "從檔案匯入共享…";
"Export or Import Shares" = "匯出或匯入共享";
"Export your saved shares to a file, or import them on another Mac" = "將已儲存的共享匯出至檔案，或在另一台 Mac 上匯入";
"Passwords are not exported. They stay in this Mac’s Keychain." = "密碼不會被匯出，它們仍保存在這台 Mac 的鑰匙圈中。";
"Could Not Export Shares" = "無法匯出共享";
"Could Not Import Shares" = "無法匯入共享";
"This file is not a MountMate network share export." = "此檔案不是 MountMate 網路共享匯出檔案。";
"This file was exported by a newer version of MountMate. Update MountMate to import it." = "此檔案由較新版本的 MountMate 匯出。請更新 MountMate 後再匯入。";
"Passwords are not exported. Add them by editing each share." = "密碼不會被匯出。請編輯每個共享以加入密碼。";

/* Login mount given up */
"Could Not Mount at Login" = "登入時無法裝載";
"MountMate couldn't mount “%1$@” after several tries: %2$@" = "MountMate 多次嘗試後仍無法裝載「%1$@」：%2$@";
"Unknown error" = "未知錯誤";

/* Share password rejected */
"Password Rejected" = "密碼遭拒";
"The server rejected the password for “%@”. MountMate stopped reconnecting it so the account doesn't get locked. Update the password in Settings → Network Shares." = "伺服器拒絕了「%@」的密碼。MountMate 已停止重新連線，以免帳號遭鎖定。請在「設定」→「網路共享」中更新密碼。";
"The server rejected the saved password, so MountMate stopped reconnecting this share. Edit the share to enter the new password." = "伺服器拒絕了已儲存的密碼，因此 MountMate 已停止重新連線此共享。請編輯共享並輸入新密碼。";
"Disks Were Not Mounted Again" = "磁碟未重新裝載";
